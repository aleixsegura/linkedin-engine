:root {
  color-scheme: light;
  --bg: #f4f2ee; --surface: #ffffff; --surface-2: #f8f8f7; --text: #191919; --muted: rgba(0, 0, 0, .6);
  --border: #e0dfdc; --accent: #0a66c2; --accent-strong: #004182; --accent-soft: #e8f1fa; --on-accent: #ffffff;
  --chip: #eeedea; --warn: #915907; --warn-soft: #fcefd9; --ok: #057642; --ok-soft: #e3f3ea;
  --danger: #b24020; --danger-soft: #fbe9e4; --selected: #edf3f8; --focus: #0a66c2;
  --series-1: #0a66c2; --series-2: #df704d; --series-3: #5f9b41; --series-4: #8f5ac2;
  --series-5: #c37d16; --series-6: #2b8a8a; --series-7: #b24060; --series-8: #6b7a8f;
  --shadow: 0 0 0 1px rgba(0, 0, 0, .08), 0 2px 3px rgba(0, 0, 0, .05);
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --bg: #1b1f23; --surface: #262b30; --surface-2: #2d3338; --text: rgba(255, 255, 255, .9);
    --muted: rgba(255, 255, 255, .62); --border: #3b434b; --accent: #71b7fb; --accent-strong: #a8d4ff;
    --accent-soft: #1f3a55; --on-accent: #10161c; --chip: #343a40; --warn: #f5b860; --warn-soft: #3d2f17;
    --ok: #7fc99a; --ok-soft: #1d3a2a; --danger: #f2937a; --danger-soft: #45251d; --selected: #2c3e50;
    --focus: #71b7fb;
    --series-1: #71b7fb; --series-2: #f29a7e; --series-3: #8fcf6f; --series-4: #c2a0f0;
    --series-5: #f0be5c; --series-6: #6dd0cf; --series-7: #f08cab; --series-8: #a9b6c8;
    --shadow: 0 0 0 1px rgba(255, 255, 255, .08);
  }
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
    "Fira Sans", Ubuntu, Oxygen, "Oxygen Sans", Cantarell, "Droid Sans", "Apple Color Emoji",
    "Segoe UI Emoji", "Segoe UI Symbol", "Lucida Grande", Helvetica, Arial, sans-serif; }
main { max-width: 1128px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 24px; font-weight: 600; margin: 0 0 4px; }
.sub { color: var(--muted); margin: 0 0 20px; font-size: 14px; }
a { color: var(--accent); font-weight: 600; text-decoration: none; }
a:hover { text-decoration: underline; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.panel { background: var(--surface); border-radius: 8px; box-shadow: var(--shadow); }
.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 16px; }
.pill { border: 1px solid var(--border); background: var(--surface); color: var(--muted); border-radius: 999px;
  padding: 5px 14px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
.pill:hover { background: var(--surface-2); color: var(--text); }
.pill[aria-pressed="true"] { background: var(--ok); color: var(--surface); border-color: var(--ok); }
input[type=search], input[type=text], input[type=number], select { border: 1px solid var(--border);
  background: var(--surface); color: var(--text); border-radius: 4px; padding: 6px 10px; font: inherit;
  font-size: 14px; min-width: 0; }
input[type=search] { border-radius: 999px; padding-left: 14px; }
.btn { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 6px 18px;
  font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; border: 1px solid var(--accent);
  background: var(--accent); color: var(--on-accent); text-decoration: none; }
.btn:hover { background: var(--accent-strong); border-color: var(--accent-strong); text-decoration: none; }
.btn.secondary { background: transparent; color: var(--accent); }
.btn.secondary:hover { background: var(--accent-soft); }
.btn:disabled { opacity: .5; cursor: default; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { background: var(--chip); border-radius: 4px; padding: 2px 8px; font-size: 12px; font-weight: 600; color: var(--text); }
.chip.domain { background: var(--accent-soft); color: var(--accent); }
.badge { display: inline-block; border-radius: 999px; padding: 1px 8px; font-size: 12px; font-weight: 600;
  background: var(--chip); color: var(--text); }
.badge.ok { background: var(--ok-soft); color: var(--ok); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.muted { color: var(--muted); font-size: 13px; }
.stats { display: flex; flex-wrap: wrap; gap: 8px 28px; padding: 14px 18px; margin: 0 0 16px; }
.stat b { display: block; font-size: 20px; font-weight: 600; }
.stat span { color: var(--muted); font-size: 13px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.up { color: var(--ok); } .down { color: var(--danger); }

/* Job search: list on the left, details on the right (single column on small screens). */
.filters { padding: 12px 16px; margin: 0 0 12px; }
.filters .bar { margin: 0; }
.filters .bar + .bar { margin-top: 10px; }
.filters label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); font-weight: 600; }
.filters input[type=search] { flex: 1 1 220px; }
.jobs { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 0; align-items: start; overflow: hidden; }
.jobs-head { grid-column: 1 / -1; padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex;
  justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
.jobs-head h2 { font-size: 16px; font-weight: 600; margin: 0; }
.job-list { list-style: none; margin: 0; padding: 0; border-right: 1px solid var(--border); max-height: 78vh; overflow: auto; }
.job-list li { border-bottom: 1px solid var(--border); }
.job { display: flex; gap: 12px; width: 100%; text-align: left; padding: 12px 16px; background: none; border: 0;
  border-left: 3px solid transparent; color: inherit; font: inherit; cursor: pointer; }
.job:hover { background: var(--surface-2); }
.job[aria-current="true"] { background: var(--selected); border-left-color: var(--ok); }
.logo { flex: none; width: 48px; height: 48px; border-radius: 4px; display: grid; place-items: center;
  font-size: 20px; font-weight: 700; color: #fff; }
.job-body { min-width: 0; flex: 1; }
.job-title { color: var(--accent); font-weight: 600; font-size: 16px; line-height: 1.3; }
.job:hover .job-title { text-decoration: underline; }
.job-company { font-size: 14px; }
.job-meta { color: var(--muted); font-size: 13px; }
.job .chips { margin-top: 6px; }
.job-new { animation: job-in .35s ease-out; }
@keyframes job-in { from { opacity: 0; transform: translateY(-4px); } }
@media (prefers-reduced-motion: reduce) { .job-new { animation: none; } }
.detail { padding: 20px 24px 28px; position: sticky; top: 0; max-height: 78vh; overflow: auto; }
.detail h3 { font-size: 22px; font-weight: 600; margin: 4px 0 4px; line-height: 1.25; }
.detail h4 { font-size: 16px; font-weight: 600; margin: 20px 0 8px; }
.detail .company-line { display: flex; align-items: center; gap: 10px; font-size: 14px; }
.detail .logo { width: 32px; height: 32px; font-size: 15px; }
.detail .facts { display: grid; gap: 4px; margin: 12px 0 14px; font-size: 14px; }
.detail .actions { display: flex; gap: 8px; flex-wrap: wrap; }
.detail .desc { white-space: pre-line; font-size: 14px; }
.skill-group { margin: 0 0 10px; }
.skill-group .muted { display: block; margin-bottom: 4px; }
.score-bar { display: inline-block; vertical-align: middle; width: 80px; height: 6px; background: var(--chip);
  border-radius: 3px; overflow: hidden; margin-left: 6px; }
.score-bar i { display: block; height: 100%; background: var(--ok); }
.empty { padding: 32px 16px; text-align: center; color: var(--muted); }
@media (max-width: 860px) {
  .jobs { grid-template-columns: minmax(0, 1fr); }
  .job-list { border-right: 0; max-height: none; overflow: visible; }
  .detail { position: static; max-height: none; border-bottom: 1px solid var(--border); background: var(--surface-2); padding: 16px; }
  .detail h3 { font-size: 19px; }
}
@media (max-width: 600px) { main { padding: 16px 16px 48px; } h1 { font-size: 21px; } .logo { width: 40px; height: 40px; } }
