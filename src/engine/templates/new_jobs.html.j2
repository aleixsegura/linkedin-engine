<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>New jobs</title>
<style>
{% include "_style.css.j2" %}
.hidden-list { margin: 0; padding: 0 18px 14px 34px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main>
  <h1>New jobs</h1>
  <p class="sub">Run #{{ run.id }} · {{ run.started_at[:16].replace("T", " ") }} UTC ·
    <a href="trends.html">See skill trends →</a></p>

  <section class="panel" aria-label="Summary" style="margin: 0 0 16px">
    <div class="stats">
      <div class="stat"><b>{{ jobs|length }}</b><span>new relevant</span></div>
      {% for region, n in by_region.items() %}
      <div class="stat"><b>{{ n }}</b><span>{{ region }}</span></div>
      {% endfor %}
      <div class="stat"><b>{{ run.n_cards }}</b><span>results reviewed</span></div>
    </div>
    {% if hidden %}
    <ul class="hidden-list">
      {% for label, n in hidden.items() %}<li>{{ n }} hidden: {{ label }}</li>{% endfor %}
    </ul>
    {% endif %}
  </section>

  <div id="jobs">
{% include "_jobs.html.j2" %}
  </div>
  <noscript><p class="muted">Enable JavaScript to see the job list.</p></noscript>
  <p class="muted">Generated {{ generated }}</p>
</main>
<script>
{% include "_jobs.js.j2" %}
JobsView(document.getElementById("jobs"), { jobs: {{ jobs_json|safe }}, emptyText: "No new relevant jobs in this run." });
</script>
</body>
</html>
