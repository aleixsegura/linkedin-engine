// Job list + details view shared by the report and the web UI. Renders with DOM APIs (no innerHTML)
// so job text is never interpreted as markup.
window.JobsView = function (root, opts = {}) {
  const $ = role => root.querySelector(`[data-role="${role}"]`);
  const list = $("list"), detail = $("detail"), q = $("q"), regionBar = $("regions");
  const workplaceSel = $("workplace"), senioritySel = $("seniority"), minInput = $("min"), sortSel = $("sort");
  const narrow = window.matchMedia("(max-width: 860px)");
  const LOGO_COLORS = ["#0a66c2", "#915907", "#057642", "#7a4fb0", "#a8324f", "#2b6f8a", "#6b5a3f", "#56657a"];
  const WORKPLACE = { remote: "Remote", hybrid: "Hybrid" };
  let jobs = [], region = "", selectedId = null, fresh = new Set();

  function h(tag, attrs, ...children) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs || {})) {
      if (v === null || v === undefined || v === false) continue;
      if (k === "class") el.className = v; else if (k === "style") el.style.cssText = v; else el.setAttribute(k, v);
    }
    for (const c of children.flat()) if (c !== null && c !== undefined && c !== false) el.append(c);
    return el;
  }
  function logo(company) {
    const name = (company || "?").trim();
    let hash = 0;
    for (const ch of name) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
    return h("span", { class: "logo", "aria-hidden": "true", style: `background:${LOGO_COLORS[hash % LOGO_COLORS.length]}` },
      (name[0] || "?").toUpperCase());
  }
  const fmtScore = s => (s === null || s === undefined) ? "—" : String(Math.round(s * 10) / 10);
  function badges(j) {
    return [
      j.workplace_type ? h("span", { class: "badge ok" }, WORKPLACE[j.workplace_type] || j.workplace_type) : null,
      j.no_sponsorship ? h("span", { class: "badge warn" }, "No visa sponsorship") : null,
    ].filter(Boolean);
  }
  const textOf = j => [j.title, j.company, j.location, j.region, ...j.skills.map(s => s.name)].join(" ").toLowerCase();

  function matches(j) {
    const term = q.value.trim().toLowerCase(), wp = workplaceSel.value, min = parseFloat(minInput.value) || 0;
    return (!region || j.region === region)
      && (!term || j._text.includes(term))
      && (!wp || (wp === "none" ? !j.workplace_type : j.workplace_type === wp))
      && (!senioritySel.value || j.seniority === senioritySel.value)
      && (j.relevance ?? 0) >= min;
  }
  function sorted(items) {
    const by = sortSel.value === "recent"
      ? (a, b) => (b.posted_at || "").localeCompare(a.posted_at || "") || (b.relevance ?? 0) - (a.relevance ?? 0)
      : (a, b) => (b.relevance ?? 0) - (a.relevance ?? 0) || (b.posted_at || "").localeCompare(a.posted_at || "");
    return [...items].sort(by);
  }

  function renderFilters() {
    const regions = [...new Set(jobs.map(j => j.region).filter(Boolean))].sort();
    if (region && !regions.includes(region)) region = "";
    const pill = (value, label) => {
      const b = h("button", { type: "button", class: "pill", "aria-pressed": String(region === value) }, label);
      b.addEventListener("click", () => { region = value; renderFilters(); renderList(); });
      return b;
    };
    regionBar.replaceChildren(pill("", "All regions"), ...regions.map(r => pill(r, r)));
    const levels = [...new Set(jobs.map(j => j.seniority).filter(s => s && s !== "Not Applicable"))].sort();
    const current = senioritySel.value;
    senioritySel.replaceChildren(new Option("Any", ""), ...levels.map(l => new Option(l, l)));
    senioritySel.value = levels.includes(current) ? current : "";
  }

  function renderList() {
    const visible = sorted(jobs.filter(matches));
    $("count").textContent = jobs.length
      ? `${visible.length} ${visible.length === 1 ? "job" : "jobs"}${visible.length !== jobs.length ? ` of ${jobs.length}` : ""}`
      : "Jobs";
    if (!visible.some(j => j.id === selectedId)) selectedId = visible.length ? visible[0].id : null;
    list.replaceChildren(...visible.map(j => {
      const btn = h("button", { type: "button", class: "job", "data-id": j.id, "aria-current": String(j.id === selectedId) },
        logo(j.company),
        h("span", { class: "job-body" },
          h("span", { class: "job-title" }, j.title), h("br"),
          h("span", { class: "job-company" }, j.company || ""), h("br"),
          h("span", { class: "job-meta" }, [j.location, j.region].filter(Boolean).join(" · ")), h("br"),
          h("span", { class: "job-meta" }, j.posted_at ? `Posted ${j.posted_at}` : ""),
          badges(j).length ? h("span", { class: "chips" }, badges(j)) : null));
      btn.addEventListener("click", () => select(j.id, true));
      return h("li", { class: fresh.has(j.id) ? "job-new" : null }, btn);
    }));
    fresh.clear();
    if (!visible.length) {
      list.append(h("li", { class: "empty" }, jobs.length ? "No jobs match these filters." : (opts.emptyText || "No jobs.")));
    }
    renderDetail();
  }

  function skillGroups(j) {
    const domain = j.skills.filter(s => s.domain), rest = j.skills.filter(s => !s.domain);
    const groups = {};
    for (const s of rest) (groups[s.category] ||= []).push(s);
    return [
      domain.length ? h("div", { class: "skill-group" }, h("span", { class: "muted" }, "Matching your profile"),
        h("div", { class: "chips" }, domain.map(s => h("span", { class: "chip domain", title: s.category }, s.name)))) : null,
      ...Object.entries(groups).map(([cat, items]) => h("div", { class: "skill-group" },
        h("span", { class: "muted" }, cat.replaceAll("_", " ")),
        h("div", { class: "chips" }, items.map(s => h("span", { class: "chip" }, s.name))))),
    ];
  }

  function renderDetail() {
    const j = jobs.find(x => x.id === selectedId);
    if (!j) { detail.hidden = true; return; }
    detail.hidden = false;
    const maxScore = Math.max(1, ...jobs.map(x => x.relevance ?? 0));
    const pct = Math.max(0, Math.min(100, 100 * (j.relevance ?? 0) / maxScore));
    const fact = (label, value) => value ? h("div", null, h("span", { class: "muted" }, `${label}: `), value) : null;
    detail.replaceChildren(...[
      h("div", { class: "company-line" }, logo(j.company), h("span", null, j.company || "")),
      h("h3", null, h("a", { href: j.url, target: "_blank", rel: "noopener" }, j.title)),
      h("div", { class: "muted" }, [j.location, j.region, j.posted_at ? `posted ${j.posted_at}` : null].filter(Boolean).join(" · ")),
      h("div", { class: "facts" },
        badges(j).length ? h("div", { class: "chips" }, badges(j)) : null,
        fact("Seniority", j.seniority && j.seniority !== "Not Applicable" ? j.seniority : null),
        fact("Employment type", j.employment_type),
        h("div", null, h("span", { class: "muted" }, "Relevance score: "), fmtScore(j.relevance),
          h("span", { class: "score-bar", "aria-hidden": "true" }, h("i", { style: `width:${pct.toFixed(0)}%` })))),
      h("div", { class: "actions" },
        h("a", { class: "btn", href: j.url, target: "_blank", rel: "noopener" }, "View on LinkedIn ↗")),
      j.skills.length ? h("h4", null, "Skills") : null,
      ...skillGroups(j),
      j.description ? h("h4", null, "About the job") : null,
      j.description ? h("div", { class: "desc" }, j.description) : null,
    ].filter(Boolean));
    placeDetail();
  }

  // On small screens the details open right below the selected job; on wide screens, in the right pane.
  function placeDetail() {
    const item = list.querySelector(`.job[data-id="${CSS.escape(selectedId || "")}"]`);
    if (narrow.matches && item) {
      let slot = list.querySelector("li.detail-slot");
      if (!slot) slot = h("li", { class: "detail-slot" });
      item.parentElement.after(slot);
      slot.append(detail);
    } else if (detail.parentElement !== list.parentElement) {
      list.after(detail);
      list.querySelector("li.detail-slot")?.remove();
    }
  }

  function select(id, focus) {
    selectedId = id;
    list.querySelectorAll(".job").forEach(b => b.setAttribute("aria-current", String(b.dataset.id === id)));
    renderDetail();
    if (focus) narrow.matches ? detail.scrollIntoView({ block: "nearest" }) : (detail.scrollTop = 0);
  }

  list.addEventListener("keydown", e => {
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    const buttons = [...list.querySelectorAll(".job")];
    const i = buttons.indexOf(document.activeElement);
    const next = buttons[i + (e.key === "ArrowDown" ? 1 : -1)];
    if (next) { e.preventDefault(); next.focus(); select(next.dataset.id, false); }
  });
  [q, minInput].forEach(el => el.addEventListener("input", renderList));
  [workplaceSel, senioritySel, sortSel].forEach(el => el.addEventListener("change", renderList));
  narrow.addEventListener("change", placeDetail);

  const prepare = j => ({ ...j, skills: j.skills || [], _text: textOf({ ...j, skills: j.skills || [] }) });
  const api = {
    setJobs(items) { jobs = items.map(prepare); selectedId = null; renderFilters(); renderList(); },
    add(job) { jobs.push(prepare(job)); fresh.add(job.id); renderFilters(); renderList(); },
    clear() { api.setJobs([]); },
    get size() { return jobs.length; },
    hint(text) { $("hint").textContent = text || ""; },
  };
  api.setJobs(opts.jobs || []);
  return api;
};
