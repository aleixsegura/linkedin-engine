<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Skill trends</title>
<style>
{% include "_style.css.j2" %}
.chart-wrap { padding: 16px; margin: 0 0 12px; height: 340px; }
.table-wrap { padding: 4px 8px; overflow-x: auto; }
tbody tr:hover { background: var(--surface-2); }
td .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }
tbody tr { cursor: pointer; }
tbody tr.sel td:first-child { font-weight: 600; color: var(--accent); }
tbody tr:focus-visible { outline-offset: -2px; }
.barcell { position: relative; }
.barfill { position: absolute; left: 0; top: 6px; bottom: 6px; background: var(--accent-soft); border-radius: 4px; z-index: 0; }
.barcell span { position: relative; z-index: 1; }
</style>
</head>
<body>
<main>
  <h1>Skill trends</h1>
  <p class="sub">% of jobs mentioning each skill · {{ n_jobs }} unique jobs in the history ·
    <a href="latest.html">← Latest jobs</a></p>

  <div class="panel filters">
  <div class="bar" id="regions" role="group" aria-label="Region">
    <button type="button" class="pill" data-region="" aria-pressed="true">All regions</button>
    {% for region in regions %}<button type="button" class="pill" data-region="{{ region }}" aria-pressed="false">{{ region }}</button>{% endfor %}
  </div>
  <div class="bar">
    <select id="cat" aria-label="Category"><option value="">All categories</option></select>
    <select id="win" aria-label="Window">
      <option value="4">Last 4 weeks</option>
      <option value="12">Last 12 weeks</option>
      <option value="0">All time</option>
    </select>
    <span class="muted" id="info"></span>
  </div>
  </div>

  <div class="chart-wrap panel"><canvas id="chart" aria-label="Weekly evolution"></canvas></div>
  <p class="muted">Click a row (or focus it and press Enter) to add it to or remove it from the chart. Δ = change in percentage points vs. the previous window of the same size.</p>

  <div class="table-wrap panel">
  <table>
    <thead><tr><th>Skill</th><th>Category</th><th class="num">% jobs</th><th class="num">Δ pp</th><th class="num">Jobs</th></tr></thead>
    <tbody id="rows"></tbody>
  </table>
  </div>
  <p class="muted">Generated {{ generated }}</p>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const DATA = {{ data_json|safe }};
(() => {
  const skills = DATA.skills, jobs = DATA.jobs;
  const weeks = [...new Set(jobs.map(j => j[0]))].sort();
  const cats = [...new Set(skills.map(s => s[1]))];
  const catSel = document.getElementById("cat"), winSel = document.getElementById("win");
  cats.forEach(c => catSel.add(new Option(c, c)));
  let region = "", selected = null, chart = null;

  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const palette = () => [1, 2, 3, 4, 5, 6, 7, 8].map(i => css(`--series-${i}`));
  const esc = v => String(v).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  const colorOf = i => { const p = palette(); return p[[...selected].indexOf(i) % p.length]; };

  function counts(ws) {
    const set = new Set(ws), c = new Array(skills.length).fill(0);
    let n = 0;
    for (const [w, r, idx] of jobs) {
      if (!set.has(w) || (region && r !== region)) continue;
      n++;
      for (const i of idx) c[i]++;
    }
    return { n, c };
  }

  function render() {
    const win = +winSel.value;
    const cur = win ? weeks.slice(-win) : weeks;
    const prev = win ? weeks.slice(-2 * win, -win) : [];
    const a = counts(cur), b = counts(prev);
    const cat = catSel.value;
    let rows = skills.map((s, i) => ({ i, name: s[0], cat: s[1], n: a.c[i],
      pct: a.n ? 100 * a.c[i] / a.n : 0, prev: b.n ? 100 * b.c[i] / b.n : null }))
      .filter(r => r.n > 0 && (!cat || r.cat === cat))
      .sort((x, y) => y.pct - x.pct).slice(0, 40);
    if (selected === null) selected = new Set(rows.slice(0, 5).map(r => r.i));
    document.getElementById("info").textContent = `${a.n} jobs in window · ${cur.length} weeks`;
    const max = rows.length ? rows[0].pct : 1;
    document.getElementById("rows").innerHTML = rows.map(r => {
      const d = r.prev === null ? "—" : (r.pct - r.prev).toFixed(1);
      const cls = r.prev === null ? "" : (r.pct - r.prev > 0.5 ? "up" : (r.pct - r.prev < -0.5 ? "down" : ""));
      const sel = selected.has(r.i);
      const swatch = sel ? `<span class="swatch" style="background:${colorOf(r.i)}"></span>` : "";
      return `<tr data-i="${r.i}" class="${sel ? "sel" : ""}" tabindex="0" aria-selected="${sel}"><td>${swatch}${esc(r.name)}</td><td class="muted">${esc(r.cat)}</td>
        <td class="num barcell"><div class="barfill" style="width:${(r.pct / max * 100).toFixed(0)}%"></div><span>${r.pct.toFixed(1)}%</span></td>
        <td class="num ${cls}">${d === "—" ? d : (d > 0 ? "+" + d : d)}</td><td class="num">${r.n}</td></tr>`;
    }).join("");
    document.querySelectorAll("#rows tr").forEach(tr => {
      const toggle = () => {
        const i = +tr.dataset.i;
        selected.has(i) ? selected.delete(i) : selected.add(i);
        render();
        document.querySelector(`#rows tr[data-i="${i}"]`)?.focus();
      };
      tr.addEventListener("click", toggle);
      tr.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); } });
    });
    drawChart(cur);
  }

  function drawChart(ws) {
    if (!window.Chart) return;
    const per = ws.map(w => counts([w]));
    const datasets = [...selected].map(i => ({
      label: skills[i][0], borderColor: colorOf(i), backgroundColor: colorOf(i), borderWidth: 2,
      data: per.map(p => p.n ? +(100 * p.c[i] / p.n).toFixed(1) : null), tension: 0.25, spanGaps: true,
    }));
    const grid = css("--border"), text = css("--muted");
    if (chart) chart.destroy();
    chart = new Chart(document.getElementById("chart"), {
      type: "line", data: { labels: ws, datasets },
      options: { maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
        scales: { y: { beginAtZero: true, ticks: { color: text, callback: v => v + "%" }, grid: { color: grid } },
                  x: { ticks: { color: text }, grid: { color: grid } } },
        plugins: { legend: { labels: { color: text } } } },
    });
  }

  document.querySelectorAll("#regions .pill").forEach(b => b.addEventListener("click", () => {
    region = b.dataset.region;
    document.querySelectorAll("#regions .pill").forEach(x => x.setAttribute("aria-pressed", x === b));
    render();
  }));
  catSel.addEventListener("change", () => { selected = null; render(); });
  winSel.addEventListener("change", render);
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", render);
  render();
})();
</script>
</body>
</html>
